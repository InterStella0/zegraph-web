# Template for the staging .env consumed by compose.staging.yaml.
#
# The real file is NOT in the repo: it lives on the runner at the path held by the
# STAGING_ENV_LOCATION repository variable, the same arrangement production uses with
# ENV_LOCATION. Copy this, fill in the blanks, and point the variable at it.

DOMAIN=staging.zegraph.xyz

# `postgres` is the compose service inside the ze-staging project -- never a production host.
DB_NAME=ze_staging
DB_HOST=postgres
DB_USERNAME=zegraph
DB_PASSWORD=
DB_PORT=5432
DATABASE_URL="postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# The same database seen from outside the compose network. Bound to the docker bridge address
# rather than loopback so one published port serves both the runner (cargo test / sqlx prepare)
# and BuildKit containers, which reach the host through host.docker.internal.
STAGING_DB_HOST_ADDR=172.17.0.1
STAGING_DB_HOST_PORT=55432
HOST_DATABASE_URL="postgres://${DB_USERNAME}:${DB_PASSWORD}@${STAGING_DB_HOST_ADDR}:${STAGING_DB_HOST_PORT}/${DB_NAME}"
BUILD_DATABASE_URL="postgres://${DB_USERNAME}:${DB_PASSWORD}@host.docker.internal:${STAGING_DB_HOST_PORT}/${DB_NAME}"

# Not PRODUCTION, so listen_new_update stays off; not DEVELOPMENT either, so the swagger UI has to
# be asked for explicitly.
ENVIRONMENT=STAGING
ENABLE_SWAGGER_UI=TRUE

REDIS_URL=redis://redis:6379/
CACHE_THUMBNAIL=/var/www/thumbnails
STEAM_API_KEY=

# Nothing to precalculate against a database that starts empty.
PRECALCULATE=FALSE
PRECALCULATE_MAP=FALSE
PRECALCULATE_PLAYER=FALSE
PRECALCULATE_PLAYER_FULL=FALSE

DISCORD_AUTH2_CLIENT_ID=
DISCORD_AUTH2_CLIENT_SECRET=
# Add this exact URI to the Discord application's allowed redirects.
DISCORD_AUTH2_REDIRECT_URI="https://${DOMAIN}/api/auth/callback"
AUTH_SECRET=
CLIENT_AUTH_REDIRECT_URI="https://${DOMAIN}"
NEXT_PUBLIC_DOMAIN="https://${DOMAIN}"
FRONTEND_URL="https://${DOMAIN}"
# Must differ from production's, or a staging session token would be accepted by production.
NEXTAUTH_SECRET=

# Empty so staging traffic stays out of the production PostHog project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Local, so staging uploads never reach the production R2 bucket.
STORE_UPLOAD=/var/www/storage
STORAGE_BACKEND=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Volume mount paths (absolute paths on the runner)
# STORAGE_PATH must contain maps/ characters/ communities/ and be owned by uid 10001.
STORAGE_PATH=/srv/ze-staging/storage
# A throwaway P-256 keypair -- the backend panics at startup if these are missing. Do not reuse the
# production keys, which are docker swarm secrets on the VPS.
VAPIDS_PATH=/srv/ze-staging/vapids
PUBLIC_FILES_PATH=/srv/ze-staging/public
REDIS_CONF_PATH=./redis.conf

# 51020 is production's.
STAGING_EXPOSE_PORT=51021

ANALYZE=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_AD_SLOT=
NEXT_PUBLIC_AD_SHOW=false
