[Unit]
Description=PostgreSQL Replica Init / WAL Recovery Check
Before=postgresql-replica.service
After=tailscaled.service network-online.target
Requires=tailscaled.service

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/local/bin/pg-replica-init.sh
RemainAfterExit=yes
TimeoutSec=600

[Install]
WantedBy=multi-user.target
