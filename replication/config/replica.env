# ------------------------------------------------------------------------------
# Deployment settings for the PostgreSQL replica auto-recovery system.
#
# This is the ONE place to change values when moving to a new machine / tailnet.
# Sourced by both scripts (pg-replica-init.sh, pg-replica-reinit.sh).
# Installed to /etc/pg-replica/replica.env by install.sh.
# ------------------------------------------------------------------------------

# Primary (the database you are replicating FROM). Over Tailscale this is the
# primary's Tailscale IP; over a LAN/VPN use whatever address the replica can reach.
PRIMARY=#TAILSCALE IP SERVER HERE
PRIMARY_PORT=5432

# Replication role on the primary (must have the REPLICATION privilege).
REPL_USER=replicator

# Physical replication slot name. Created automatically by pg_basebackup -C.
SLOT=replica_pc

# Local paths on the replica machine.
PGDATA=/var/lib/postgres/replica          # the replica's data directory
CONFDIR=/var/lib/postgres/replica-conf    # static config, lives OUTSIDE the data dir
